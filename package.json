{
  "name": "playwright-ecommerce-e2e",
  "version": "1.0.0",
  "description": "End-to-end test suite for e-commerce application using Playwright and Page Object Model",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
