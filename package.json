    "test:report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "e2e",
    "testing",
    "page-object-model",
    "qa",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5"
  }
}
